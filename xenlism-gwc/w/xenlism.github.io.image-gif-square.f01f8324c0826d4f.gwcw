{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.image-gif-square","name":"Image / Animated GIF Square By Xenlism","description":"1x1 desktop picture frame. Pick a static image or an animated GIF - GIFs loop in place; anything else is shown as a still image. Same widget as \"Image / Animated GIF\" but sized as a compact 1x1 square by default.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":300,"y":300,"monitor":0},"catalog":"decoration","perm":["fs-write:~"]},"package":{"encoding":"zip+base64","size":5507,"sha256":"90e33ae2bc0469b10f2782d8c9f8703e9f7a1f66f49f754d22555aa566a4b6ab","files":["README.md","config.json","widget.js"],"data":""}}