{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.circles-cpu-half","name":"CPU (Half Ring) By Xenlism","description":"1x1 card: CPU usage as a half-circle (semicircle) ring next to a percentage label, instead of a full circle. The ring side can be flipped to hug the left or right edge of the card.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":1744,"y":245,"monitor":0},"screenshot":"screenshot.png","catalog":"system","perm":["none"]},"package":{"encoding":"zip+base64","size":22587,"sha256":"61f5bc2bf0235d2e52f78a814ac5cf0bc508dbfa497d8149d729acdac17753bc","files":["config.json","screenshot.png","widget.js"],"data":""}}