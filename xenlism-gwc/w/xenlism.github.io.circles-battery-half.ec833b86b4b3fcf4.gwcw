{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.circles-battery-half","name":"Battery (Half Ring) By Xenlism","description":"1x1 card: battery charge as a half-circle (semicircle) ring next to a percentage label, instead of a full circle. Ring color bands by charge level and switches to a charging color (with a bolt glyph) while plugged in. The ring side can be flipped to hug the left or right edge of the card.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":0,"y":90,"monitor":0},"screenshot":"screenshot.png","catalog":"system","perm":["none"]},"package":{"encoding":"zip+base64","size":73021,"sha256":"438b2866ae9d2201b86209b1eca0e23c9c225bb29fe59d2680dd24d1dfe34787","files":["config.json","screenshot.png","widget.js"],"data":""}}