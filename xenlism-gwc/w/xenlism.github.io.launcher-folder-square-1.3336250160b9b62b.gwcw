{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.launcher-folder-square-1","name":"Folder Launcher (Square) By Xenlism","description":"Android-style launcher shortcut for FOLDERS: 4 folders in a 2x2 grid, no labels, click opens each in your default file manager. Recognizes XDG special folders (Downloads, Documents, Music, Pictures, Videos, Desktop, Public, Templates, Home) and shows their proper icon instead of a generic folder icon.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":956,"y":569,"monitor":0},"catalog":"launcher","perm":["fs-read:~","subprocess"]},"package":{"encoding":"zip+base64","size":3207,"sha256":"58f16317e0ed100ac0da99b78d3022e89d33812b6b15c243c10653383df36db9","files":["config.json","widget.js"],"data":""}}