{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.settings-control-bar","name":"Settings Control (Bar) By Xenlism","description":"Wide `barx2` card (23×5 grid cells): the same Wi-Fi/Ethernet, Bluetooth (or Airplane Mode), Do Not Disturb, and Dark/Light mode toggle buttons as the Settings Control card, evenly spaced in a single row instead of a 2x2 grid.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"barx2","default-position":{"x":1536,"y":50,"monitor":0},"screenshot":"screenshot.png","catalog":"other","perm":["none"]},"package":{"encoding":"zip+base64","size":23084,"sha256":"0338b9866c96ef2bf9ba0251d9735f050a985a2c49b283a0f7277ee731faa99c","files":["config.json","screenshot.png","stylesheet.css","widget.js"],"data":""}}