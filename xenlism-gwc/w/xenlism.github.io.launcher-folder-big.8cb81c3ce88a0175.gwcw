{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.launcher-folder-big","name":"Folder Launcher Big By Xenlism","description":"Android-style launcher grid for FOLDERS instead of apps: pick up to 9 directories, each shown with your system's folder icon. Clicking one opens it in your default file manager (Nautilus by default).","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"2x2","default-position":{"x":337,"y":560,"monitor":0},"screenshot":"screenshot.png","catalog":"launcher","perm":["fs-read:~","subprocess"]},"package":{"encoding":"zip+base64","size":7734,"sha256":"32e8572fb9a96c00786de837fcaa456b442a3fe87bd40d2ece6281cabf783b67","files":["config.json","screenshot.png","widget.js"],"data":""}}