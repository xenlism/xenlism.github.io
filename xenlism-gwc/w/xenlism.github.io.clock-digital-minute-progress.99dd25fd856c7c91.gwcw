{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.clock-digital-minute-progress","name":"Clock (Digital Minute Progress) By Xenlism","description":"Digital HH:MM clock card with a ring of dash marks that fill in dark as the current minute passes - light dashes are minutes not reached yet. No hands, no numerals.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":123,"y":740,"monitor":0},"catalog":"clock","perm":["subprocess"]},"package":{"encoding":"zip+base64","size":5030,"sha256":"9cd0288ebf35e80af944036679b9f355b0b088e257dfbd8b7a9b12346949859f","files":["README.md","config.json","widget.js"],"data":""}}