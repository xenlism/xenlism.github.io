{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.screen-time","name":"Screen Time By Xenlism","description":"2x1 card tracking today's active screen time (based on keyboard/mouse idle time via Mutter's idle monitor) against a daily goal, with a color-coded progress bar.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"2x1","default-position":{"x":80,"y":520,"monitor":0},"catalog":"clock","perm":["none"]},"package":{"encoding":"zip+base64","size":5491,"sha256":"64f40b3583ce8e183143f51e3784228ebf61f059650b6a5223b2447734069644","files":["README.md","config.json","widget.js"],"data":""}}