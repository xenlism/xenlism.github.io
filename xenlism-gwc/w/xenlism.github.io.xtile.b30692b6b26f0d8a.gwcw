{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.xtile","name":"Xtile By Xenlism","description":"Architect widget for the Xtile family: an empty launcher tile whose edit-mode toolbar gains an \"Add Widget\" icon. Clicking it opens a dialog to name a new tile and search for an installed app, then creates a real Xtile Child configured for that app - no manual .desktop path editing needed. Xtile Firefox/Chrome/Terminal/GIMP/Inkscape remain separate bundled presets; this is the generic version for any app.","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":572,"y":761,"monitor":0},"catalog":"other","perm":["fs-read:~","subprocess"]},"package":{"encoding":"zip+base64","size":7613,"sha256":"67693aaeb80b02ee5012805f7904913a26689bb2cc11c8724fb0ebe30e110cca","files":["child/config.json","child/widget.js","config.json","stylesheet.css","widget.js"],"data":""}}