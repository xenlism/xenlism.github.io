{"format":"gwcw","version":1,"metadata":{"id":"xenlism.github.io.pomodoro-timer","name":"Pomodoro Timer By Xenlism","description":"1x1 ring gauge Pomodoro timer - Work / Short break / Long break cycle with a play/pause button. The ring color shifts red/yellow/green as the phase's time runs low (or use one fixed color per phase instead).","version":"1.0.0","author":"Nattapong Pullkhow","api-version":2,"entry":"widget.js","block-type":"1x1","default-position":{"x":80,"y":300,"monitor":0},"catalog":"productivity","perm":["none"]},"package":{"encoding":"zip+base64","size":6804,"sha256":"8d639dc5092b70f48a394927d0780692676ea2e794603124ec60b3438c983c1c","files":["README.md","config.json","widget.js"],"data":""}}